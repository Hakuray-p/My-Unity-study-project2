%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93aa61041cff7ae45ac5e408a0482ab9, type: 3}
  m_Name: merchant
  m_EditorClassIdentifier: 
  speakerId: merchant
  displayName: "\u5546\u4EBA"
  cityId: first_light
  storyEventId: first_light_event_merchant
  interactionType: 1
  eventId: first_light_event_merchant
  sceneChat:
  - speakerId: merchant
    text: "买卡包三折起，买关键单卡按市价翻倍。闲聊五分钟收一枚铜币折旧费，考虑清楚再张嘴。"
  - speakerId: shizuku
    text: "我只是路过看了一眼招牌，收银台的算盘就已经拨响三回了，老板。"
  interaction:
  - speakerId: merchant
    text: "‘叮铃’一声，客官踏进店门的损耗折合半枚铜币。买卡、打听八卦，还是纯粹找老骨头消磨时间？"
  - speakerId: shizuku
    text: "按一次 E 就要收半枚铜币，整座城物价最离谱的就是你这里了。"
  - speakerId: merchant
    text: "嘿，小本生意，诚信经营。看在熟客的分上，今天看橱窗里的卡套免费，摸一下还是要收钱的。"
  eventDialogue:
  - speakerId: merchant
    text: "买药草在前面右拐，找稀有卡在前面左拐。后巷闲逛要收折损费，一分钟一枚铜币。"
  - speakerId: shizuku
    text: "我只是想问，柜子里那个红丝绒盒，上面的封蜡看起来换了不下五次吧？"
  - speakerId: merchant
    text: "一件三年卖不出去、也没人来赎的东西，在账本上叫‘死账’，早该扔进熔炉当废料。"
  - speakerId: shizuku
    text: "那你为什么每天傍晚都要把它拿出来擦一遍？也是为了计入维护成本吗？"
  - speakerId: merchant
    text: "有个傻瓜当年把这东西押在我这儿，换了半袋盘缠出城。他说等他回来，照十倍市价赎。"
  - speakerId: shizuku
    text: "所以你在等他回来还债。"
  - speakerId: merchant
    text: "不，我是在等一个能证明世上真有傻子会信守承诺的证据。抽三张牌，拿出一点不计成本的狠劲，我就免费讲给你听。"
  normal:
  - speakerId: merchant
    text: "看卡还是参赛？你先看，我把这笔账记完。"
  - speakerId: shizuku
    text: "我想配卡，但今天先不买。"
  - speakerId: merchant
    text: "那就先看。想清楚缺什么，再花钱。"
  - speakerId: shizuku
    text: "你不劝我多买几张？"
  - speakerId: merchant
    text: "劝你买错了，明天还得回来找我。"
  - speakerId: shizuku
    text: "听起来你挺怕麻烦。"
  - speakerId: merchant
    text: "我怕的是账对不上。麻烦倒还好。"
  - speakerId: shizuku
    text: "那我先记住自己缺什么，再来找你。"
  afterEvent:
  - speakerId: merchant
    text: "卡背那两道细线，我认得。那两个年轻人以前来过店里。"
  - speakerId: shizuku
    text: "他们后来没一起参赛？"
  - speakerId: merchant
    text: "我只知道他们说过“下次一起”。后面的事，我不能替他们补。"
  - speakerId: shizuku
    text: "那张卡先别拿来卖。"
  - speakerId: merchant
    text: "放心，我也没打算卖。谁交来的、放了多久，我会记清楚。"
  - speakerId: shizuku
    text: "黑猫少女也在整理记录。"
  - speakerId: merchant
    text: "她要是需要暂存，我可以帮忙。"
  - speakerId: shizuku
    text: "条件呢？"
  - speakerId: merchant
    text: "写清楚谁保管，什么时候拿走。人情也得有个说法。"
  - speakerId: shizuku
    text: "这样我反而放心。"
  ending:
  - speakerId: merchant
    text: "恭喜夺冠。今天买卡，还是只看看？"
  - speakerId: shizuku
    text: "只看看。冠军也没有突然多一份预算。"
  - speakerId: merchant
    text: "这才像会过日子。旧卡的事呢？"
  - speakerId: shizuku
    text: "先照原来的约定保管，不摆到货架上。"
  - speakerId: merchant
    text: "好。你们今年认识的人，可以另记一份。"
  - speakerId: shizuku
    text: "别把我的账本也算进去。"
  - speakerId: merchant
    text: "账本是我的，不外借。"
  - speakerId: shizuku
    text: "知道了，我今天不碰你的账。"
  storyVictory:
  - speakerId: merchant
    text: "为了抢最后一点伤害，居然敢把手牌全当弃子扔进墓地……真是一笔烂账，但确实够狠。"
  - speakerId: shizuku
    text: "把放不下的回忆说成讨债，你的利息算得可真够别扭的。"
  storyDefeat:
  - speakerId: merchant
    text: "承蒙惠顾。你的资源管理算得太漂亮，可惜漂亮在真正的生意场上可换不来胜利。"
  - speakerId: shizuku
    text: "……算得太精，反而被你的卖血换卡套牢了，奸商。"
  - speakerId: merchant
    text: "骂得好！这叫沉没成本的教训，输给我不丢人，至少我没收你双倍学费。"
  matches:
  - matchId: first_light_public_04
    beforeMatch:
    - speakerId: merchant
      text: "我把账本收好了，可以打一局。"
    - speakerId: shizuku
      text: "输赢不会影响店里的价吧？"
    - speakerId: merchant
      text: "不会。价钱归价钱，比赛归比赛。"
    - speakerId: shizuku
      text: "那我也把卡检查一遍，省得输了怪牌。"
    victory:
    - speakerId: merchant
      text: "输了。这局打得我没空算账。"
    - speakerId: shizuku
      text: "那我算不算帮你休息了一会儿？"
    - speakerId: merchant
      text: "脑子更忙了，但确实比算账有意思。"
    - speakerId: shizuku
      text: "那下次有空再来，账和牌分开算。"
    defeat:
    - speakerId: merchant
      text: "这场我赢了。先别急着买一整副新卡。"
    - speakerId: shizuku
      text: "你赢了还不推销？"
    - speakerId: merchant
      text: "缺什么再买，买错了我也不替你背锅。"
    - speakerId: shizuku
      text: "行，我先把手里的用明白。"
