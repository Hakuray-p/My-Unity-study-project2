%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93aa61041cff7ae45ac5e408a0482ab9, type: 3}
  m_Name: blackcat
  m_EditorClassIdentifier: 
  speakerId: blackcat
  displayName: "\u9ED1\u732B\u5C11\u5973"
  cityId: first_light
  storyEventId: first_light_event_01
  interactionType: 2
  eventId: first_light_event_01
  normal:
  - speakerId: blackcat
    text: "\u5357\u4FA7\u6865\u524D\u51FA\u73B0\u4E86\u4E00\u9053\u88C2\u75D5\uFF0C\u91CC\u9762\u6709\u5F20\u6CA1\u6709\u4E3B\u4EBA\u7684\u5361\u3002\u4F60\u613F\u610F\u548C\u6211\u4E00\u8D77\u786E\u8BA4\u5B83\u7684\u6765\u5386\u5417\uFF1F"
  - speakerId: shizuku
    text: "\u597D\uFF0C\u6211\u4F1A\u8BA4\u771F\u51C6\u5907\u3002\u4E5F\u60F3\u542C\u542C\u8FD9\u5EA7\u57CE\u91CC\u5927\u5BB6\u7684\u6545\u4E8B\u3002"
  afterEvent:
  - speakerId: blackcat
    text: "\u6865\u8FB9\u7684\u88C2\u75D5\u5DF2\u7ECF\u5E73\u606F\u4E86\u3002\u539F\u6765\u90A3\u5F20\u5361\u8BB0\u7740\u4E00\u4EFD\u5F88\u4E45\u4EE5\u524D\u7684\u7EA6\u5B9A\u3002"
  - speakerId: shizuku
    text: "\u5927\u5BB6\u4E00\u8D77\u627E\u56DE\u4E86\u5B83\u7684\u6765\u5386\uFF0C\u6211\u4E5F\u80FD\u5B89\u5FC3\u51C6\u5907\u63A5\u4E0B\u6765\u7684\u6BD4\u8D5B\u4E86\u3002"
  ending:
  - speakerId: blackcat
    text: "\u606D\u559C\u4F60\u6210\u4E3A\u51A0\u519B\uFF0C\u4E5F\u8C22\u8C22\u4F60\u8BA4\u771F\u5BF9\u5F85\u90A3\u5F20\u7EAA\u5FF5\u5361\u3002\u4EE5\u540E\u4E5F\u5E38\u6765\u8FD9\u91CC\u5427\u3002"
  - speakerId: shizuku
    text: "\u4F1A\u7684\u3002\u6BD4\u8D5B\u6709\u7EC8\u70B9\uFF0C\u4F46\u6211\u8FD8\u60F3\u7EE7\u7EED\u8BA4\u8BC6\u8FD9\u91CC\u7684\u6BCF\u4E00\u4E2A\u4EBA\u3002"
  matches:
  - matchId: first_light_champion
    beforeMatch:
    - speakerId: blackcat
      text: "\u51C6\u5907\u597D\u4E86\u5C31\u5F00\u59CB\u5427\u3002\u8FD9\u4E00\u573A\uFF0C\u8BF7\u62FF\u51FA\u81EA\u5DF1\u7684\u5224\u65AD\u3002"
    - speakerId: shizuku
      text: "\u51C6\u5907\u597D\u4E86\uFF0C\u8BF7\u591A\u6307\u6559\u3002"
    victory:
    - speakerId: blackcat
      text: "\u8FD9\u4E00\u573A\u4F60\u8D62\u4E86\uFF0C\u7EE7\u7EED\u4FDD\u6301\u4E13\u6CE8\u3002"
    - speakerId: shizuku
      text: "\u8C22\u8C22\u3002\u6211\u4E5F\u4ECE\u4F60\u7684\u9009\u62E9\u91CC\u5B66\u5230\u4E86\u5F88\u591A\u3002"
    defeat:
    - speakerId: blackcat
      text: "\u522B\u7070\u5FC3\uFF0C\u8C03\u6574\u5361\u7EC4\u4EE5\u540E\u8FD8\u53EF\u4EE5\u518D\u6311\u6218\u3002"
    - speakerId: shizuku
      text: "\u6211\u4F1A\u8BB0\u4F4F\u8FD9\u4E00\u573A\uFF0C\u518D\u6765\u627E\u4F60\u5207\u78CB\u3002"
