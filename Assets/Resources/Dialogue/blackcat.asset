%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93aa61041cff7ae45ac5e408a0482ab9, type: 3}
  m_Name: blackcat
  m_EditorClassIdentifier: 
  speakerId: blackcat
  displayName: "\u9ED1\u732B\u5C11\u5973"
  cityId: first_light
  storyEventId: first_light_event_01
  interactionType: 2
  eventId: first_light_event_01
  sceneChat:
  - speakerId: blackcat
    text: "如果只是观光，请移步商业街。城防节点周围十米禁止闲杂人员停留。"
  - speakerId: shizuku
    text: "我只是确认一下这条路通不通。你眉毛拧得太紧，会让整条街的气氛都变沉。"
  interaction:
  - speakerId: blackcat
    text: "有事？如果不是赛场安全隐患汇报，请不要占用城卫人员的时间。"
  - speakerId: shizuku
    text: "只是顺路来看看你。从昨天开始你就没合过眼吧，黑眼圈都要挂到嘴角了。"
  - speakerId: blackcat
    text: "……这是合理的执勤损耗，城律里没有犯困就可以撤岗的特例。请退到安全警戒线以外，谢谢。"
  eventDialogue:
  - speakerId: blackcat
    text: "离开这里。这里的魔力共振已经达到阈值，不是外来参赛者该看的热闹。"
  - speakerId: shizuku
    text: "你的手在抖。刚才强行用罗盘压制回路，被反噬了吧？"
  - speakerId: blackcat
    text: "只是静电反应。城卫署的手册上没有因疲惫请求支援这一项。我能处理。"
  - speakerId: shizuku
    text: "‘我不确定’有这么难说出口吗？桥下的那张卡也是，这里的节点也是，你把所有责任都压在自己一个人头上。"
  - speakerId: blackcat
    text: "那也比寄希望于不可靠的外人强！如果失败，代价由我一个人承担！"
  - speakerId: shizuku
    text: "那就打一场。如果你输了，至少在节点排查完之前，允许我站在你旁边递工具。"
  - speakerId: blackcat
    text: "……狂妄的新人。你会为你的多管闲事后悔的。"
  normal:
  - speakerId: blackcat
    text: "来得正好——等等，你现在有空吗？"
  - speakerId: shizuku
    text: "有空。是桥边又出事了？"
  - speakerId: blackcat
    text: "南侧桥前有道裂痕，里面夹着一张无主卡。我还没查清原因。"
  - speakerId: shizuku
    text: "你想让我做什么？"
  - speakerId: blackcat
    text: "我去翻旧记录，你去看看卡背和周围的光。看不懂的地方别硬猜。"
  - speakerId: shizuku
    text: "好，我会把看到的先记下来。"
  - speakerId: blackcat
    text: "谢谢。刚才我差点又想一个人全包了。"
  - speakerId: shizuku
    text: "那就现在分好，别等忙完才说。"
  afterEvent:
  - speakerId: blackcat
    text: "记录还差最后一段。裂痕平息时，那些光是先聚起来，再散开，对吗？"
  - speakerId: shizuku
    text: "我记得大概是，但中间有几下太亮，我没看清。"
  - speakerId: blackcat
    text: "那就写“没看清”，别替它补答案。旧卡留下的思念已经平息，这点能确定。"
  - speakerId: shizuku
    text: "商人说他认得那对搭档，但也不是每件事都知道。"
  - speakerId: blackcat
    text: "嗯。卡可以请他暂存，记录我来核对。只是交接还得写清楚——"
  - speakerId: shizuku
    text: "这些能不能等会儿？我有点饿了。"
  - speakerId: blackcat
    text: "……我也没吃。再写一行也不会让饭自己出现。"
  - speakerId: shizuku
    text: "那先到这里，吃完回来再看。"
  ending:
  - speakerId: blackcat
    text: "冠军赛和调查都结束了，我手里突然少了两件事。"
  - speakerId: shizuku
    text: "你不会马上再找两件新的补上吧？"
  - speakerId: blackcat
    text: "我刚才确实这么想过。"
  - speakerId: shizuku
    text: "那今天先别想。"
  - speakerId: blackcat
    text: "你现在说话越来越像猫姬了。"
  - speakerId: shizuku
    text: "她至少会先问我想不想听。"
  - speakerId: blackcat
    text: "好，那你想不想陪我走一段？"
  - speakerId: shizuku
    text: "想。今天不用急着解决什么。"
  storyVictory:
  - speakerId: blackcat
    text: "防线被正面击穿了。既然输了，协议成立……递扳手的时候别挡住仪表灯。"
  - speakerId: shizuku
    text: "先擦手上的擦伤。逞强赢不了比赛，也护不住整座城。"
  storyDefeat:
  - speakerId: blackcat
    text: "胜负已分。你的战术存在致命的迟疑，防壁被攻破时还想保留反击的手牌。天真。"
  - speakerId: shizuku
    text: "……我想把伤害降到最低，结果反而被你连环击破了。"
  - speakerId: blackcat
    text: "犹疑只会招致全灭。至少把这种软弱收起来，别死在半路上。"
  matches:
  - matchId: first_light_champion
    beforeMatch:
    - speakerId: blackcat
      text: "这场先不谈调查。我也想好好当一次你的对手。"
    - speakerId: shizuku
      text: "我正想这么说。别一边出牌一边惦记其他事。"
    - speakerId: blackcat
      text: "好。能走到这里，你也准备很久了。"
    - speakerId: shizuku
      text: "所以我想赢。今天先不客气。"
    victory:
    - speakerId: blackcat
      text: "你赢了，雫。冠军是你的。让我缓一口气，再好好恭喜你。"
    - speakerId: shizuku
      text: "我也想缓一会儿。刚才一直不敢松劲。"
    - speakerId: blackcat
      text: "看来我们都没你表现得那么镇定。"
    - speakerId: shizuku
      text: "我可没说自己镇定。只是想先把这一局打完。"
    defeat:
    - speakerId: blackcat
      text: "这场我赢了。你不用现在就决定什么时候再来。"
    - speakerId: shizuku
      text: "我会再来。但我想先把这一局消化掉。"
    - speakerId: blackcat
      text: "好。我在这里，等你准备好。"
    - speakerId: shizuku
      text: "到时也请这样认真打。我不想因为别的事情被让着。"
