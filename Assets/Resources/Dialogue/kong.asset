%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93aa61041cff7ae45ac5e408a0482ab9, type: 3}
  m_Name: kong
  m_EditorClassIdentifier: 
  speakerId: kong
  displayName: "\u7A7A"
  cityId: first_light
  storyEventId: first_light_event_01
  interactionType: 0
  eventId: 
  normal:
  - speakerId: kong
    text: "\u4F60\u4E5F\u542C\u89C1\u4E86\u5417\uFF1F\u5E7F\u573A\u5B89\u9759\u4E0B\u6765\u7684\u65F6\u5019\uFF0C\u5361\u724C\u4F1A\u53D1\u51FA\u5F88\u8F7B\u7684\u58F0\u54CD\u3002"
  - speakerId: shizuku
    text: "\u6211\u53EA\u770B\u89C1\u5149\u4E00\u95EA\u4E00\u95EA\u3002\u4F60\u5728\u8FD9\u91CC\u89C2\u5BDF\u5F88\u4E45\u4E86\uFF1F"
  - speakerId: kong
    text: "\u6211\u53EB\u7A7A\u3002\u6BCF\u5F53\u6BD4\u8D5B\u7ED3\u675F\uFF0C\u5357\u4FA7\u6865\u524D\u7684\u6CE2\u52A8\u5C31\u4F1A\u7A0D\u5FAE\u53D8\u5F3A\u3002"
  - speakerId: shizuku
    text: "\u50CF\u662F\u6709\u4EBA\u8FD8\u4E0D\u613F\u610F\u8BA9\u6BD4\u8D5B\u7ED3\u675F\u3002"
  - speakerId: kong
    text: "\u4E5F\u8BB8\u3002\u9ED1\u732B\u5C11\u5973\u6B63\u5728\u627E\u4EBA\u8C03\u67E5\u90A3\u91CC\u3002\u5148\u522B\u628A\u672A\u77E5\u7684\u4E1C\u897F\u5F53\u6210\u654C\u4EBA\u3002"
  - speakerId: shizuku
    text: "\u6211\u4F1A\u5148\u542C\u5B83\u60F3\u8868\u8FBE\u4EC0\u4E48\uFF0C\u518D\u51B3\u5B9A\u600E\u4E48\u505A\u3002"
  afterEvent:
  - speakerId: kong
    text: "\u6865\u8FB9\u5B89\u9759\u4E0B\u6765\u4E86\u3002\u4F60\u6CA1\u6709\u628A\u90A3\u5F20\u5361\u6BC1\u6389\uFF0C\u771F\u597D\u3002"
  - speakerId: shizuku
    text: "\u5361\u80CC\u7684\u5B57\u6BD4\u88C2\u75D5\u66F4\u6E05\u695A\uFF1A\u4E0B\u6B21\uFF0C\u4E00\u8D77\u53C2\u8D5B\u3002"
  - speakerId: kong
    text: "\u5F3A\u70C8\u7684\u601D\u5FF5\u7559\u5728\u5361\u724C\u91CC\uFF0C\u88AB\u57CE\u91CC\u7684\u6BD4\u8D5B\u5524\u9192\uFF0C\u624D\u6709\u4E86\u90A3\u4E9B\u56DE\u54CD\u3002"
  - speakerId: shizuku
    text: "\u73B0\u5728\u77E5\u9053\u6709\u4EBA\u542C\u89C1\uFF0C\u5B83\u5C31\u4E0D\u7528\u518D\u5236\u9020\u90A3\u4E48\u5927\u7684\u58F0\u97F3\u4E86\u3002"
  - speakerId: kong
    text: "\u6BD4\u8D5B\u4E5F\u4E00\u6837\uFF0C\u542C\u61C2\u5BF9\u624B\u7684\u9009\u62E9\uFF0C\u6709\u65F6\u6BD4\u731C\u4E2D\u4E0B\u4E00\u5F20\u724C\u66F4\u91CD\u8981\u3002"
  - speakerId: shizuku
    text: "\u4E0B\u6B21\u548C\u4F60\u5BF9\u5C40\uFF0C\u6211\u4F1A\u8BA4\u771F\u542C\u3002"
  ending:
  - speakerId: kong
    text: "\u4ECA\u5929\u7684\u5E7F\u573A\u5F88\u70ED\u95F9\uFF0C\u5374\u4E0D\u518D\u8BA9\u4EBA\u4E0D\u5B89\u3002\u606D\u559C\u4F60\uFF0C\u96EB\u3002"
  - speakerId: shizuku
    text: "\u8C22\u8C22\u3002\u6BD4\u8D77\u5956\u7AE0\uFF0C\u6211\u66F4\u9AD8\u5174\u6211\u4EEC\u5F04\u660E\u767D\u4E86\u90A3\u9053\u88C2\u75D5\u3002"
  - speakerId: kong
    text: "\u65E7\u7EA6\u5B9A\u6CA1\u6709\u6D88\u5931\uFF0C\u53EA\u662F\u7EC8\u4E8E\u53EF\u4EE5\u5B89\u9759\u5730\u88AB\u4EBA\u8BB0\u4F4F\u3002"
  - speakerId: shizuku
    text: "\u4F60\u4F1A\u7EE7\u7EED\u5750\u5728\u8FD9\u91CC\u89C2\u5BDF\u5417\uFF1F"
  - speakerId: kong
    text: "\u4F1A\u3002\u4E5F\u8BB8\u4E0B\u4E00\u6B21\uFF0C\u6211\u89C2\u5BDF\u7684\u662F\u670B\u53CB\u4EEC\u4E00\u573A\u666E\u901A\u7684\u5BF9\u5C40\u3002"
  - speakerId: shizuku
    text: "\u90A3\u6211\u7ED9\u81EA\u5DF1\u7559\u4E2A\u4F4D\u7F6E\uFF0C\u6BD4\u8D5B\u7ED3\u675F\u540E\u4E5F\u6765\u966A\u4F60\u5750\u5750\u3002"
  matches:
  - matchId: first_light_kong_challenge
    beforeMatch:
    - speakerId: kong
      text: "\u51C6\u5907\u597D\u4E86\u5417\uFF1F\u8FD9\u4E00\u573A\u8BA4\u771F\u6253\uFF0C\u7ED3\u675F\u540E\u6211\u4EEC\u518D\u6162\u6162\u804A\u3002"
    - speakerId: shizuku
      text: "\u51C6\u5907\u597D\u4E86\u3002\u65E0\u8BBA\u7ED3\u679C\u5982\u4F55\uFF0C\u90FD\u8BF7\u591A\u6307\u6559\u3002"
    victory:
    - speakerId: kong
      text: "\u8FD9\u573A\u662F\u4F60\u8D62\u4E86\uFF0C\u96EB\u3002\u4F60\u7684\u9009\u62E9\u5F88\u6F02\u4EAE\uFF0C\u6211\u8BB0\u4F4F\u4E86\u3002"
    - speakerId: shizuku
      text: "\u8C22\u8C22\u4F60\u8BA4\u771F\u5E94\u6218\u3002\u4E0B\u4E00\u6B21\uFF0C\u6211\u4EEC\u90FD\u4F1A\u66F4\u8FDB\u6B65\u3002"
    defeat:
    - speakerId: kong
      text: "\u8FD9\u6B21\u8FD8\u5DEE\u4E00\u70B9\u3002\u522B\u6025\uFF0C\u5931\u8D25\u4E0D\u4F1A\u8BA9\u4F60\u7684\u52AA\u529B\u767D\u8D39\u3002"
    - speakerId: shizuku
      text: "\u6211\u4F1A\u91CD\u65B0\u68C0\u67E5\u5361\u7EC4\uFF0C\u518D\u6765\u8BA4\u771F\u6311\u6218\u4F60\u3002"
