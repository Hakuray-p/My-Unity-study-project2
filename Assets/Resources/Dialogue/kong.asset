%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93aa61041cff7ae45ac5e408a0482ab9, type: 3}
  m_Name: kong
  m_EditorClassIdentifier: 
  speakerId: kong
  displayName: "\u7A7A"
  cityId: first_light
  storyEventId: first_light_event_kong
  interactionType: 0
  eventId: first_light_event_kong
  sceneChat:
  - speakerId: kong
    text: "……今天风里的味道，有点像烤焦的蓝莓面包。"
  - speakerId: shizuku
    text: "那是因为街角面包房的学徒又把烤箱温度调高了，空，你靠在栏杆上太久会着凉的。"
  interaction:
  - speakerId: kong
    text: "雫的脚步声，听起来比刚才重了一点点。是口袋里的卡盒变沉了吗？"
  - speakerId: shizuku
    text: "是刚才走得有点急。你一直坐在这里，肚子不饿吗？"
  - speakerId: kong
    text: "刚才有一只白色的鸟衔走了一块面包屑。看着它飞走，就不觉得饿了。不过……要是雫有多余的糖果，空也可以帮你分担一点点哦。"
  eventDialogue:
  - speakerId: kong
    text: "今天早上，风从东南边吹过来，带着一点锈铁和旧纸张的味道。"
  - speakerId: shizuku
    text: "那是桥下地脉沉降的味道吧。空，整座城都在忙着开赛，你为什么总一个人坐在这里？"
  - speakerId: kong
    text: "因为桥底下很冷清啊。那张卡躺在石头缝里，水流每冲过一次，就在那里震动一次，像一直在敲门，却没有人去开。"
  - speakerId: shizuku
    text: "……所以你每天坐在这儿，是为了替它听外面的声音？"
  - speakerId: kong
    text: "要是有人能坐在这里，和我打一场很慢、很慢的牌，哪怕只是一小会儿，桥下的敲门声听起来就不会那么寂寞了吧。"
  - speakerId: shizuku
    text: "我今天上午没有比赛。你想打多慢，我都陪你。"
  normal:
  - speakerId: kong
    text: "你刚才在桥那边停了一下？"
  - speakerId: shizuku
    text: "嗯，听见一点声音。"
  - speakerId: kong
    text: "我也听见了。很轻，不一直有。"
  - speakerId: shizuku
    text: "你在这里等它再响？"
  - speakerId: kong
    text: "算是吧。每次比赛散场以后，它好像会回来一会儿。"
  - speakerId: shizuku
    text: "这件事你告诉黑猫少女了吗？"
  - speakerId: kong
    text: "还没有。我怕只是我听错，让她白跑。"
  - speakerId: shizuku
    text: "那就把你听见的告诉她，没听清的也一起说。"
  afterEvent:
  - speakerId: kong
    text: "今天桥边没有声音了。"
  - speakerId: shizuku
    text: "嗯，路过的人也少了。"
  - speakerId: kong
    text: "你要坐一会儿吗？这边没晒到。"
  - speakerId: shizuku
    text: "你不是还在记东西？"
  - speakerId: kong
    text: "不急。"
  - speakerId: shizuku
    text: "那我坐五分钟。"
  - speakerId: kong
    text: "五分钟到了要叫我。"
  - speakerId: shizuku
    text: "好。你要是睡着了，我就叫你两次。"
  ending:
  - speakerId: kong
    text: "今天人很多，我就没去广场。"
  - speakerId: shizuku
    text: "你不喜欢热闹？"
  - speakerId: kong
    text: "有时候喜欢。只是今天想安静一点。"
  - speakerId: shizuku
    text: "那我们就在这里说话。"
  - speakerId: kong
    text: "其实不用一直说。你坐着就行。"
  - speakerId: shizuku
    text: "你这是第一次明确邀请别人陪你吧？"
  - speakerId: kong
    text: "……可能是。"
  - speakerId: shizuku
    text: "那我答应了，别临时反悔。"
  storyVictory:
  - speakerId: kong
    text: "最后一张卡翻开的时候，声音听起来很温柔呢……像有人轻轻应了一声‘我在’。"
  - speakerId: shizuku
    text: "嗯，谢谢你。下次要是风声又太吵，我再来陪你坐一会儿。"
  storyDefeat:
  - speakerId: kong
    text: "啊……赢了吗？空只是按照水流的声音把牌放下去而已。雫，手疼不疼？"
  - speakerId: shizuku
    text: "傻瓜，道什么歉。你的节奏把我的场面全化解了……打得很好，是我大意了。"
  - speakerId: kong
    text: "那……吃颗糖吧。等风变暖的时候，我们再打一局。"
  matches:
  - matchId: first_light_kong_challenge
    beforeMatch:
    - speakerId: kong
      text: "想打一局吗？我可能会想得比较久。"
    - speakerId: shizuku
      text: "没关系，我也不想赶着出牌。"
    - speakerId: kong
      text: "那就好。安静不代表我没认真打。"
    - speakerId: shizuku
      text: "我知道。开始吧。"
    victory:
    - speakerId: kong
      text: "你赢了。我想把这局再想一遍。"
    - speakerId: shizuku
      text: "要我先说说我当时怎么想的吗？"
    - speakerId: kong
      text: "先让我猜一次。猜错了你再告诉我。"
    - speakerId: shizuku
      text: "好，我等你猜。"
    defeat:
    - speakerId: kong
      text: "这局结束了。你还想坐一会儿吗？"
    - speakerId: shizuku
      text: "想。我有点不甘心，但现在不想马上再来。"
    - speakerId: kong
      text: "那就不打第二局。"
    - speakerId: shizuku
      text: "嗯，谢谢你没直接说“下次一定”。"
