%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93aa61041cff7ae45ac5e408a0482ab9, type: 3}
  m_Name: fei
  m_EditorClassIdentifier: 
  speakerId: fei
  displayName: "\u7EEF"
  cityId: first_light
  storyEventId: first_light_event_fei
  interactionType: 0
  eventId: first_light_event_fei
  sceneChat:
  - speakerId: fei
    text: "喂！站住！手上的茧子变厚了嘛，要不要现在来一把？不用挑地方，踩着这块砖就能抽卡！"
  - speakerId: shizuku
    text: "集市正中央禁止私斗，企鹅的哨子已经在嘴边了，我可不想跟你一起被罚扫大街。"
  interaction:
  - speakerId: fei
    text: "你终于过来了！手痒得要死，你刚才走过来的八步里，我已经脑补了三次把你的前锋砍碎的画面了！打不打？一句话！"
  - speakerId: shizuku
    text: "……你脑补的画面未免太暴力了。我是来确认下午集合地点的，别整天脑子里只有抽卡砍人。"
  - speakerId: fei
    text: "少啰嗦！真正的牌手用刀剑和手牌说话！不打就别站在我剑风能扫到的范围内晃悠！"
  eventDialogue:
  - speakerId: fei
    text: "迟到了两分十七秒！我不管企鹅发了什么场地延期通告，我的手早就发烫了！"
  - speakerId: shizuku
    text: "延期是因为刚才赛场魔力回流，企鹅在重新核验安全线。我来是想告诉你，今天的对决改到明天——"
  - speakerId: fei
    text: "闭嘴！约定就是约定，你人既然站在这里，手就别想插在口袋里当看客！拔卡！"
  - speakerId: shizuku
    text: "你总是把自己的兴致排在所有规则前面。"
  - speakerId: fei
    text: "瞻前顾后的人抽出来的卡也是软绵绵的！雫，你打牌的时候根本没在看我！"
  - speakerId: shizuku
    text: "……说我软绵绵？很好。这场不算在正式赛程里，但我会让你知道，尊重对手和遵守规则到底哪个更重要。"
  normal:
  - speakerId: fei
    text: "雫！来得正好，要不要打一局？"
  - speakerId: shizuku
    text: "今天恐怕不行，我答应蕾贝卡先查赛册。"
  - speakerId: fei
    text: "啊？现在就去？"
  - speakerId: shizuku
    text: "她已经等一会儿了。"
  - speakerId: fei
    text: "那我跟你们一起去，查完总能打吧？"
  - speakerId: shizuku
    text: "你刚才还说只打一局。"
  - speakerId: fei
    text: "我想打是真的，答应别人的事也得做完。"
  - speakerId: shizuku
    text: "这句话你自己记住就好，回头别赖账。"
  afterEvent:
  - speakerId: fei
    text: "桥边真的安静下来了。你刚才看见了吗？"
  - speakerId: shizuku
    text: "看见了。就是最后那一下光，有点吓人。"
  - speakerId: fei
    text: "我还以为你什么都不怕。"
  - speakerId: shizuku
    text: "比赛我不怕，突然亮一下还是会吓到。"
  - speakerId: fei
    text: "这事你可别告诉别人。"
  - speakerId: shizuku
    text: "我考虑一下。"
  - speakerId: fei
    text: "喂！"
  - speakerId: shizuku
    text: "好啦，不拿这个逗你了。今天还打吗？"
  ending:
  - speakerId: fei
    text: "冠军！先别走，问你件事。"
  - speakerId: shizuku
    text: "你先问，别又直接把我拉到牌桌边。"
  - speakerId: fei
    text: "你今天有空吗？"
  - speakerId: shizuku
    text: "这次倒记得先问安排了。"
  - speakerId: fei
    text: "蕾贝卡教我的。她说不能把别人的空闲当成自己的。"
  - speakerId: shizuku
    text: "这话听着挺有用。"
  - speakerId: fei
    text: "所以改天再打。今天你想逛街就逛街，想休息就休息。"
  - speakerId: shizuku
    text: "好。下次见面，我可不会因为你拿了冠军就放水。"
  storyVictory:
  - speakerId: fei
    text: "痛快！刚才那一手强压真够劲！没想到你咬人这么狠。"
  - speakerId: shizuku
    text: "你的攻势如果不留退路，早晚会被反制卡吃空。不过，确实让我打起精神了。"
  storyDefeat:
  - speakerId: fei
    text: "哈！太慢了！你的防壁脆得跟纸糊的一样，根本不够尽兴啊！"
  - speakerId: shizuku
    text: "……攻势太凶了，完全没给我喘息的空隙。"
  - speakerId: fei
    text: "别摆出一副输不起的脸！回去把卡组改厚一点，下一次我还在这里等你！"
  matches:
  - matchId: first_light_fei_challenge
    beforeMatch:
    - speakerId: fei
      text: "终于轮到这一局了！先说好，我就是冲着赢来的。"
    - speakerId: shizuku
      text: "巧了，我也没打算只来陪练。"
    - speakerId: fei
      text: "那就好。我最怕人一上来就说“输赢都行”。"
    - speakerId: shizuku
      text: "等打完再客气，现在先认真来。"
    victory:
    - speakerId: fei
      text: "……我输了。现在就想再来一局。"
    - speakerId: shizuku
      text: "先让我高兴一会儿。你答应认真打，也得认真认输。"
    - speakerId: fei
      text: "认，这局你赢。"
    - speakerId: shizuku
      text: "那就约下次，别趁我还没反应过来又开一局。"
    defeat:
    - speakerId: fei
      text: "这局归我！你现在是不是也想马上重来？"
    - speakerId: shizuku
      text: "想，但我先想想自己哪里太急了。"
    - speakerId: fei
      text: "要我陪你看吗？我可不会因为说了就下次让你。"
    - speakerId: shizuku
      text: "不用让。能赢回来，我才高兴。"
