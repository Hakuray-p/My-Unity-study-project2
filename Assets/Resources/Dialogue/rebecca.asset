%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93aa61041cff7ae45ac5e408a0482ab9, type: 3}
  m_Name: rebecca
  m_EditorClassIdentifier: 
  speakerId: rebecca
  displayName: "\u857E\u8D1D\u5361"
  cityId: first_light
  storyEventId: first_light_event_rebecca
  interactionType: 0
  eventId: first_light_event_rebecca
  sceneChat:
  - speakerId: rebecca
    text: "根据《城市集会秩序法》第十二条，两人在走廊对视超过三秒即存在斗殴前兆！好了，既然你移开视线了，嫌疑解除。"
  - speakerId: shizuku
    text: "我只是在确认公告板上的比赛时间，请不要随便给人加戏。"
  interaction:
  - speakerId: rebecca
    text: "停下！按 E 的动作过于果断，我合理怀疑你携带着未报备的违禁卡组！经过目测，你的卡盒符合规格，指控撤销。找本风纪委员有什么业务？"
  - speakerId: shizuku
    text: "你的怀疑能不能稍微讲点概率学……我只是想问一下今天赛区的通行限制。"
  - speakerId: rebecca
    text: "目前全线通畅！不过只要石桥那边有一点动静，我随时准备启动全城封锁令，你最好时刻保持警惕！"
  eventDialogue:
  - speakerId: rebecca
    text: "停步！嫌疑人雫！你踏入档案室的左脚倾斜了五度，这显然是企图潜入销毁证据的心虚步态！"
  - speakerId: shizuku
    text: "我只是来查下一轮比赛的场地限制。还有，那边的梯子螺丝松了，你最好扶好。"
  - speakerId: rebecca
    text: "关于三年前石桥那对搭档的档案，为什么偏偏在今天被抽走了两页？真相只有一个：就是你为了掩盖桥下的异常！"
  - speakerId: shizuku
    text: "借阅记录上最后签字的是商人，时间是今天上午九点。你下定论前，哪怕多低头看一眼呢？"
  - speakerId: rebecca
    text: "好的！关于你的指控全部作废！转为将商人列为头号嫌疑人！陪我打一场模拟推演战！"
  - speakerId: shizuku
    text: "……你改口的速度如果能分一半给打牌的思考时间，风纪部大概早就天下太平了。"
  normal:
  - speakerId: rebecca
    text: "你找我？先说好，桥边的传闻我还没查完。"
  - speakerId: shizuku
    text: "我想问问那本旧赛册。"
  - speakerId: rebecca
    text: "可以问，但我现在只能说我确认过的。"
  - speakerId: shizuku
    text: "我不想把猜测当结论。"
  - speakerId: rebecca
    text: "那我们说得很清楚。最近有人把裂痕说成作弊，我还在查是不是同一件事。"
  - speakerId: shizuku
    text: "如果需要帮忙，我可以去问商人。"
  - speakerId: rebecca
    text: "好。不过先听完我再安排你，别一听见线索就自己冲过去。"
  - speakerId: shizuku
    text: "知道，我这次等你说完。"
  afterEvent:
  - speakerId: rebecca
    text: "调查结果我已经整理好了。没有作弊。"
  - speakerId: shizuku
    text: "那传闻可以停了。"
  - speakerId: rebecca
    text: "我会把经过写清楚，免得又有人乱猜。"
  - speakerId: shizuku
    text: "旧卡主人的私事呢？"
  - speakerId: rebecca
    text: "……不必全写。我刚才只想着把事情讲完整，忘了有些事不该到处传。"
  - speakerId: shizuku
    text: "能意识到就好。"
  - speakerId: rebecca
    text: "你这句话听起来像在批改我的报告。"
  - speakerId: shizuku
    text: "如果你愿意，我可以帮你看一遍。"
  - speakerId: rebecca
    text: "好。不过不合适的地方，你直接说。"
  - speakerId: shizuku
    text: "我本来就会直接说。"
  ending:
  - speakerId: rebecca
    text: "恭喜夺冠。今天我不查记录，先给自己放半天假。"
  - speakerId: shizuku
    text: "你还会给自己放假吗？"
  - speakerId: rebecca
    text: "会。绯要是来约战，我就说今天不打。"
  - speakerId: shizuku
    text: "听上去你已经想好怎么拒绝她了。"
  - speakerId: rebecca
    text: "她最近学会先问安排了，我也得学。"
  - speakerId: shizuku
    text: "那我不占你的假期。"
  - speakerId: rebecca
    text: "你可以留下聊天。我说的是不比赛，不是赶人。"
  - speakerId: shizuku
    text: "哦，那我刚才走得有点早。"
  storyVictory:
  - speakerId: rebecca
    text: "手牌保留率极高，反制逻辑无懈可击……好吧！本席宣布，你的战术推演完全成立。"
  - speakerId: shizuku
    text: "能痛快承认别人的推论，大概是你身上唯一称得上可靠的地方了。"
  storyDefeat:
  - speakerId: rebecca
    text: "判决成立！在我的严密推理连锁面前，你的破绽像没关严的档案室大门一样显眼！"
  - speakerId: shizuku
    text: "……被你的连环封锁压得一张核心都打不出来，确实输得彻底。"
  - speakerId: rebecca
    text: "回去把你的防守检索牌多加两张，遇到破坏分子你连自保都做不到！"
  matches:
  - matchId: first_light_rebecca_challenge
    beforeMatch:
    - speakerId: rebecca
      text: "准备好了吗？有拿不准的规则，我们先说。"
    - speakerId: shizuku
      text: "规则清楚。拿不准的是我能不能赢。"
    - speakerId: rebecca
      text: "这个要打过才知道，我也不会因为你客气就让。"
    - speakerId: shizuku
      text: "那就好。请认真跟我打一场。"
    victory:
    - speakerId: rebecca
      text: "是你赢了。这局算得明明白白。"
    - speakerId: shizuku
      text: "听你这么说，我才敢松口气。"
    - speakerId: rebecca
      text: "怎么，怕我输了不认？"
    - speakerId: shizuku
      text: "不怕。只是你一直很认真，我也不想敷衍。"
    defeat:
    - speakerId: rebecca
      text: "这局我赢。你不用急着说自己准备得不够。"
    - speakerId: shizuku
      text: "我确实有想错的地方。但我也不是随便来的。"
    - speakerId: rebecca
      text: "我知道。刚才那句话说得像在评你，是我说快了。"
    - speakerId: shizuku
      text: "那我们只聊这一局，好吗？"
